#include <winuser.h>
#include <winver.h>
#include "../src/version.h"

1 ICON "murmur.ico"
1 RT_MANIFEST "murmur.manifest"

1 VERSIONINFO
FILEVERSION MURMUR_VER_MAJOR,MURMUR_VER_MINOR,MURMUR_VER_PATCH,0
PRODUCTVERSION MURMUR_VER_MAJOR,MURMUR_VER_MINOR,MURMUR_VER_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Murmur"
      VALUE "ProductName", "Murmur"
      VALUE "ProductVersion", MURMUR_VERSION
      VALUE "FileVersion", MURMUR_FILE_VERSION
      VALUE "InternalName", "Murmur"
      VALUE "OriginalFilename", "Murmur.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
